{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "apps/api/src/security/*.ts",
    "apps/api/src/creator-session.ts",
    "apps/api/src/creator-review.ts",
    "apps/web/src/creator-review-client.ts"
  ]
}
