{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@rightsreceipt/domain": [
        "packages/domain/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/application/src/consent-contract.ts",
    "packages/application/src/consent-integrity.ts",
    "packages/application/src/human-consent.ts",
    "packages/persistence/src/human-consent.ts",
    "apps/api/src/human-consent-routes.ts"
  ]
}
