{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@rightsreceipt/domain": [
        "packages/domain/src/index.ts"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "apps/api/src/transaction-routes.ts",
    "apps/api/src/receipt-routes.ts",
    "apps/api/src/buyer-review.ts",
    "apps/api/src/creator-review.ts",
    "apps/web/src/buyer-review-client.ts",
    "apps/web/src/creator-review-client.ts"
  ]
}
